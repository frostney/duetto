# Wine 8 on 32-bit Debian: runs i386-win32 duetto binaries under Wine's
# WinSock2 + I/O completion port implementation. Loopback only; no
# SChannel (the wss:// battery section is Linux-only anyway).
#
#   docker build --platform linux/386 -f tools/win32/Dockerfile.wine -t duetto-wine32:bookworm tools/win32
FROM i386/debian:bookworm

RUN apt-get update -qq \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq wine wine32 xauth xvfb \
  && rm -rf /var/lib/apt/lists/*

ENV WINEARCH=win32 WINEDEBUG=-all WINEPREFIX=/wine-prefix
# Create the prefix now: under emulation wineboot takes minutes, and it
# would otherwise run on every container start.
RUN xvfb-run -a wineboot --init && wineserver -w
COPY run.sh /usr/local/bin/run-win32
RUN chmod +x /usr/local/bin/run-win32
ENTRYPOINT ["/usr/local/bin/run-win32"]
